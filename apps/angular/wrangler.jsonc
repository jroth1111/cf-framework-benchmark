{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cf-bench-angular",
	"main": "./dist/server/server.mjs",
	"compatibility_date": "2026-03-05",
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/browser"
	},
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	]
}
