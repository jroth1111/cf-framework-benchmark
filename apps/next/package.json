{
  "name": "cf-bench-next",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 5176",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build && node ./scripts/patch-opennext-worker.mjs",
    "deploy": "pnpm run build:worker && opennextjs-cloudflare deploy",
    "preview": "pnpm run build:worker && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@cf-bench/bench-types": "workspace:*",
    "@cf-bench/bench-config": "workspace:*",
    "@cf-bench/chart-core": "workspace:*",
    "@cf-bench/chart-hooks": "workspace:*",
    "@cf-bench/dataset": "workspace:*",
    "@cf-bench/ui": "workspace:*",
    "@opennextjs/cloudflare": "1.19.6",
    "next": "16.2.4",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3",
    "wrangler": "4.87.0"
  }
}
