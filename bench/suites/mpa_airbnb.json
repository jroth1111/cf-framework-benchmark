{
  "id": "mpa_airbnb",
  "description": "Workers-only multi-page benchmark focused on listing and blog navigation",
  "scenarios": [
    {
      "name": "home",
      "routeId": "/",
      "type": "document",
      "waitFor": "a[href=\"/stays\"]"
    },
    {
      "name": "stays",
      "routeId": "/stays",
      "type": "document",
      "waitFor": { "requiredTestId": "stay-card" }
    },
    {
      "name": "stay_detail",
      "routeId": "/stays/:id",
      "type": "document",
      "waitFor": { "requiredTestId": "stay-description" }
    },
    {
      "name": "blog",
      "routeId": "/blog",
      "type": "document",
      "waitFor": { "requiredTestId": "blog-post-card" }
    },
    {
      "name": "blog_post",
      "routeId": "/blog/:slug",
      "type": "document",
      "waitFor": { "requiredTestId": "blog-html" }
    }
  ]
}
