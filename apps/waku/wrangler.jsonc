{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cf-bench-waku",
	"main": "./src/worker.ts",
	"compatibility_flags": [
		"nodejs_compat",
		"nodejs_als"
	],
	"compatibility_date": "2026-03-05",
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/public",
		"html_handling": "drop-trailing-slash",
		"run_worker_first": [
			"/",
			"/stays",
			"/stays/*",
			"/blog",
			"/blog/*",
			"/chart",
			"/media",
			"/api/*"
		]
	}
}
