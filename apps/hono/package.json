{
	"name": "hono",
	"type": "module",
	"scripts": {
		"prebuild": "esbuild src/client/chart-client.ts --bundle --format=esm --target=es2022 --outfile=public/assets/chart-client.js --minify",
		"predev": "esbuild src/client/chart-client.ts --bundle --format=esm --target=es2022 --outfile=public/assets/chart-client.js",
		"predeploy": "esbuild src/client/chart-client.ts --bundle --format=esm --target=es2022 --outfile=public/assets/chart-client.js --minify",
		"dev": "wrangler dev",
		"build": "wrangler deploy --dry-run --minify",
		"preview": "pnpm run build && wrangler dev",
		"deploy": "wrangler deploy --minify",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings"
	},
	"dependencies": {
		"@cf-bench/bench-config": "workspace:*",
		"@cf-bench/bench-contract": "workspace:*",
		"@cf-bench/bench-types": "workspace:*",
		"@cf-bench/chart-core": "workspace:*",
		"@cf-bench/dataset": "workspace:*",
		"hono": "4.12.17"
	},
	"devDependencies": {
		"@types/node": "25.6.0",
		"esbuild": "0.28.0",
		"wrangler": "4.87.0"
	}
}
