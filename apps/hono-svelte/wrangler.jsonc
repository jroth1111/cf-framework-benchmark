{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cf-bench-hono-svelte",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-06",
	"assets": {
		"binding": "ASSETS",
		"directory": "./public"
	},
	"observability": {
		"enabled": true
	},
	"vars": { "NODE_ENV": "production" }
}
