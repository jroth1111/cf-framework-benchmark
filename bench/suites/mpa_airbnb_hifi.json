{
  "id": "mpa_airbnb_hifi",
  "description": "Workers-only high-fidelity Airbnb-shaped MPA. Mobile journey with hero image LCP, photo gallery, reviews, booking widget, static map, and third-party SDK weight. Governed by docs/contracts-v6-addendum.md.",
  "scenarios": [
    {
      "name": "home",
      "routeId": "/",
      "type": "document",
      "waitFor": "a[href=\"/stays\"]"
    },
    {
      "name": "hifi_stays",
      "routeId": "/hifi/stays",
      "type": "document",
      "waitFor": { "requiredTestId": "stay-card" }
    },
    {
      "name": "hifi_stay_detail",
      "routeId": "/hifi/stays/:id",
      "type": "document",
      "waitFor": { "requiredTestId": "stay-hero-image" },
      "interactType": "journey"
    },
    {
      "name": "blog",
      "routeId": "/blog",
      "type": "document",
      "waitFor": { "requiredTestId": "blog-post-card" }
    },
    {
      "name": "blog_post",
      "routeId": "/blog/:slug",
      "type": "document",
      "waitFor": { "requiredTestId": "blog-html" }
    }
  ]
}
