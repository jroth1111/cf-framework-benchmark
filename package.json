{
  "name": "cf-benchmark",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "deploy": "node scripts/deploy-bench.mjs",
    "deploy:matrix": "node scripts/deploy-bench.mjs",
    "test": "pnpm -r test",
    "check:matrix": "node scripts/check-matrix-drift.mjs",
    "check:targets": "node scripts/verify-workers-targets.mjs",
    "test:dataset": "node scripts/test-dataset.mjs",
    "test:contracts": "node scripts/contract-tests.mjs",
    "smoke": "node scripts/smoke.mjs",
    "bench": "pnpm -C bench exec node src/run-v3.mjs --suite mpa_airbnb",
    "bench:spa": "pnpm -C bench exec node src/run-v3.mjs --suite spa_trading_media",
    "bench:all": "pnpm bench && pnpm bench:spa",
    "bench:flame": "pnpm -C bench run run:flame",
    "bench:smoke": "pnpm -C bench exec node src/run-v3.mjs --suite mpa_airbnb --iterations 1 --profile parity && pnpm -C bench exec node src/run-v3.mjs --suite spa_trading_media --iterations 1 --profile parity",
    "bench:load": "pnpm -C bench run load",
    "bench:remote": "node scripts/bench-remote.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
