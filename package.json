{
  "name": "cf-benchmark",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:enabled": "node scripts/build-enabled.mjs",
    "build:hifi-frameworks": "node scripts/generate-hifi-suite-frameworks.mjs",
    "check:hifi-frameworks": "node scripts/generate-hifi-suite-frameworks.mjs --check",
    "dev": "pnpm -r --parallel dev",
    "deploy": "node scripts/deploy-bench.mjs",
    "deploy:matrix": "node scripts/deploy-bench.mjs",
    "deploy:control": "pnpm -C apps/control run deploy",
    "test": "pnpm -r test",
    "check:matrix": "node scripts/check-matrix-drift.mjs",
    "check:targets": "node scripts/verify-workers-targets.mjs",
    "check:contracts-docs": "node scripts/check-contracts-docs.mjs",
    "test:dataset": "node scripts/test-dataset.mjs",
    "test:deploy-bench": "node scripts/test-deploy-bench.mjs",
    "test:bench-contract": "node scripts/test-bench-contract.mjs",
    "test:hifi-suite-frameworks": "node scripts/test-hifi-suite-frameworks.mjs",
    "test:matrix-schema": "node scripts/test-matrix-schema.mjs",
    "test:bench-runner": "node scripts/test-bench-runner.mjs",
    "test:contract-report": "node scripts/test-contract-report.mjs",
    "test:control-package": "node scripts/test-control-package.mjs",
    "test:hifi-live-header-config": "node scripts/test-hifi-live-header-config.mjs",
    "test:verify-results": "node scripts/test-verify-results.mjs",
    "test:ci-workflows": "node scripts/test-ci-workflows.mjs",
    "test:bench-stability": "node --check scripts/bench-stability.mjs",
    "test:cloudflare-config": "node scripts/test-cloudflare-config-audit.mjs",
    "test:cloudflare-config-fixtures": "node scripts/test-cloudflare-config-fixtures.mjs",
    "test:version-packages": "node scripts/test-version-packages.mjs",
    "test:no-direct-targets-read": "node scripts/test-no-direct-targets-read.mjs",
    "test:app-delegation": "node scripts/test-app-delegation.mjs",
    "test:cloudflare-optimization": "node scripts/test-cloudflare-optimization-audit.mjs",
    "test:cloudflare-optimization-variants-schema": "node scripts/test-cloudflare-optimization-variants-schema.mjs",
    "test:smoke-contract-selectors": "node scripts/test-smoke-contract-selectors.mjs",
    "test:contract-api-cache": "node scripts/test-contract-api-cache.mjs",
    "test:build-enabled": "node --check scripts/build-enabled.mjs",
    "check:startup": "node scripts/check-worker-startup.mjs",
    "test:contracts": "node scripts/contract-tests.mjs",
    "cloudflare:config-audit": "node scripts/cloudflare-config-audit.mjs",
    "cloudflare:optimization-audit": "node scripts/cloudflare-optimization-audit.mjs",
    "contract:report": "node scripts/contract-report.mjs",
    "verify:results": "node scripts/verify-results.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify:static": "node scripts/verify-static.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "bench": "pnpm -C bench exec node src/run-v4.mjs --suite mpa_airbnb",
    "bench:spa": "pnpm -C bench exec node src/run-v4.mjs --suite spa_trading_media",
    "bench:hifi": "pnpm -C bench exec node src/run-v4.mjs --suite mpa_airbnb_hifi",
    "bench:all": "pnpm bench && pnpm bench:spa && pnpm bench:hifi",
    "bench:flame": "pnpm -C bench exec node src/run-v4.mjs --suite spa_trading_media --iterations 1 --profile parity --flamegraphs --out ./bench/results.v4.spa_trading_media.flame.json",
    "bench:smoke": "pnpm -C bench exec node src/run-v4.mjs --suite mpa_airbnb --iterations 1 --profile parity --out ./bench/results.v4.mpa_airbnb.smoke.json && pnpm -C bench exec node src/run-v4.mjs --suite spa_trading_media --iterations 1 --profile parity --out ./bench/results.v4.spa_trading_media.smoke.json",
    "bench:stability": "node scripts/bench-stability.mjs",
    "bench:load": "pnpm -C bench run load",
    "bench:remote": "node scripts/bench-remote.mjs",
    "bench:report:regen": "node scripts/regen-report.mjs",
    "lighthouse:compare": "node scripts/lighthouse-compare.mjs"
  },
  "devDependencies": {
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.6.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "packageExtensions": {
      "@analogjs/vite-plugin-nitro@2.5.0": {
        "dependencies": {
          "h3": "1.15.11"
        }
      }
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
