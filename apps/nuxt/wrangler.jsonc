{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cf-bench-nuxt",
	"main": "./worker.mjs",
	"compatibility_date": "2026-03-05",
	"assets": {
		"binding": "ASSETS",
		"directory": "./.output/public/"
	},
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	]
}
