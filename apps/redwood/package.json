{
  "name": "cf-bench-redwood",
  "version": "1.0.0",
  "description": "Cloudflare Workers benchmark app for RedwoodSDK",
  "main": "index.js",
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "vite build",
    "dev": "vite dev",
    "dev:init": "rw-scripts dev-init",
    "preview": "pnpm run build && wrangler dev",
    "worker:run": "rw-scripts worker-run",
    "clean": "npm run clean:vite",
    "clean:vite": "rm -rf ./node_modules/.vite",
    "release": "rw-scripts ensure-deploy-env && npm run clean && npm run build && wrangler deploy",
    "generate": "rw-scripts ensure-env && wrangler types --include-runtime false",
    "check": "npm run generate && npm run types",
    "types": "tsc",
    "deploy": "pnpm run release",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@cf-bench/bench-contract": "workspace:*",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-server-dom-webpack": "19.2.4",
    "rwsdk": "1.0.0-beta.55"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.25.1",
    "@types/node": "~24.10.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "babel-plugin-react-compiler": "1.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "wrangler": "4.70.0"
  }
}
