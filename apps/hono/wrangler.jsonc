{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cf-bench-hono",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-05",
	"assets": {
		"binding": "ASSETS",
		"directory": "./public",
		"run_worker_first": [
			"/",
			"/stays",
			"/stays/*",
			"/blog",
			"/blog/*",
			"/chart",
			"/media",
			"/api/*"
		]
	}
}
