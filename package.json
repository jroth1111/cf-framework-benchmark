    "jsonc-parser": "3.3.1",
    "smol-toml": "1.6.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "packageExtensions": {
      "@analogjs/vite-plugin-nitro@2.5.0": {
        "dependencies": {
          "h3": "1.15.11"
        }
      }
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
