  "tiers": {
    "framework-runtime": "Framework-owned full-stack runtime with SSR: results in the headline scoreboard.",
    "framework-prerender": "Framework that defaults to prerendering/static for bench routes: scoreboard bucketed separately.",
    "wrapper-baseline": "Custom Worker + library (no framework-owned runtime): useful as a comparison floor, not a framework result.",
    "worker-baseline": "Hono or Hono+UI-lib: raw Worker HTML generation used as a performance ceiling/lower bound.",
    "framework-experimental": "Blocked or in-progress framework implementation: excluded from all scoreboards until unblocked."
  },
