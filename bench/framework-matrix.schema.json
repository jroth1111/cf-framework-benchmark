{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cf-bench.dev/framework-matrix.schema.json",
  "title": "cf-bench framework matrix",
  "description": "Authoritative shape for bench/framework-matrix.json. Validated by bench/src/validate-schema.mjs from inside bench/src/config-v4.mjs#loadMatrix before the existing enum checks. Drift is gated by scripts/test-matrix-schema.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "tiers", "benchmarkDefaults", "frameworks"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version", "platform", "capturedAt"],
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "capturedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framework-runtime",
        "framework-prerender",
        "wrapper-baseline",
        "worker-baseline",
        "framework-experimental"
      ],
      "properties": {
        "framework-runtime": { "type": "string", "minLength": 1 },
        "framework-prerender": { "type": "string", "minLength": 1 },
        "wrapper-baseline": { "type": "string", "minLength": 1 },
        "worker-baseline": { "type": "string", "minLength": 1 },
        "framework-experimental": { "type": "string", "minLength": 1 }
      }
    },
    "benchmarkDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementationKind", "scenarioContracts"],
      "properties": {
        "implementationKind": { "$ref": "#/$defs/implementationKind" },
        "scenarioContracts": { "$ref": "#/$defs/scenarioContractsBySuite" }
      }
    },
    "frameworks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/framework" }
    }
  },
  "$defs": {
    "implementationKind": {
      "type": "string",
      "enum": ["native", "control"]
    },
    "tierName": {
      "type": "string",
      "enum": [
        "framework-runtime",
        "framework-prerender",
        "wrapper-baseline",
        "worker-baseline",
        "framework-experimental"
      ]
    },
    "frameworkStatus": {
      "type": "string",
      "enum": ["implemented", "blocked", "scaffolded"]
    },
    "frameworkName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "renderMode": {
      "type": "string",
      "enum": ["ssr", "prerender", "spa"]
    },
    "initialDataMode": {
      "type": "string",
      "enum": ["document", "client-fetch"]
    },
    "hydrationModel": {
      "type": "string",
      "enum": ["framework", "none"]
    },
    "scenarioContract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "renderMode": { "$ref": "#/$defs/renderMode" },
        "initialData": { "$ref": "#/$defs/initialDataMode" },
        "hydrationModel": { "$ref": "#/$defs/hydrationModel" }
      }
    },
    "scenarioContractsBySuite": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "$ref": "#/$defs/scenarioContract" }
      }
    },
    "deployBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "command"],
      "properties": {
        "type": { "type": "string", "enum": ["workers"] },
        "command": { "type": "string", "minLength": 1 }
      }
    },
    "compositionBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "frontend"],
      "properties": {
        "backend": { "$ref": "#/$defs/frameworkName" },
        "frontend": { "$ref": "#/$defs/frameworkName" }
      }
    },
    "hifiBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "imageTransforms": {
          "type": "string",
          "enum": ["enabled"]
        },
        "reference": { "type": "boolean" }
      }
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "tier", "status", "benchmarkEnabled", "appDir", "deploy"],
      "properties": {
        "name": { "$ref": "#/$defs/frameworkName" },
        "c3Template": { "$ref": "#/$defs/frameworkName" },
        "benchmarkVariantOf": { "$ref": "#/$defs/frameworkName" },
        "tier": { "$ref": "#/$defs/tierName" },
        "status": { "$ref": "#/$defs/frameworkStatus" },
        "benchmarkEnabled": { "type": "boolean" },
        "blockedReason": { "type": "string", "minLength": 1 },
        "appDir": {
          "type": "string",
          "pattern": "^apps/[a-z][a-z0-9-]*$"
        },
        "implementationKind": { "$ref": "#/$defs/implementationKind" },
        "composition": { "$ref": "#/$defs/compositionBlock" },
        "hifi": { "$ref": "#/$defs/hifiBlock" },
        "scenarioContracts": { "$ref": "#/$defs/scenarioContractsBySuite" },
        "deploy": { "$ref": "#/$defs/deployBlock" }
      }
    }
  }
}
