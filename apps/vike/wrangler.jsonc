{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "cf-bench-vike",
	"compatibility_date": "2026-03-05",
	"main": "src/worker.ts",
	"assets": {
		"directory": "./dist/client/",
		"binding": "ASSETS",
		"html_handling": "drop-trailing-slash",
		"run_worker_first": [
			"/",
			"/stays",
			"/stays/*",
			"/hifi/stays",
			"/hifi/stays/*",
			"/blog",
			"/blog/*",
			"/chart",
			"/media",
			"/api/*"
		]
	},
	"vars": {
		"NODE_ENV": "production"
	}
}
