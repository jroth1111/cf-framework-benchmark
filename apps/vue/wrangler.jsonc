{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cf-bench-vue",
	"compatibility_date": "2026-03-05",
	"main": "server/index.ts",
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist",
		"not_found_handling": "none",
		"html_handling": "drop-trailing-slash",
		"run_worker_first": [
			"/",
			"/stays",
			"/stays/*",
			"/blog",
			"/blog/*",
			"/chart",
			"/media",
			"/hifi/stays",
			"/hifi/stays/*",
			"/api/*"
		]
	},
	"observability": {
		"enabled": true
	},
	"vars": { "NODE_ENV": "production" }
}
