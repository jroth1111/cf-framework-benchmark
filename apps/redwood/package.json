{
  "name": "cf-bench-redwood",
  "version": "1.0.0",
  "description": "Cloudflare Workers benchmark app for RedwoodSDK",
  "main": "index.js",
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "prebuild": "esbuild src/app/client/chart-client.ts --bundle --format=esm --target=es2022 --outfile=public/assets/chart-client.js --minify",
    "predev": "esbuild src/app/client/chart-client.ts --bundle --format=esm --target=es2022 --outfile=public/assets/chart-client.js",
    "build": "vite build",
    "dev": "vite dev",
    "dev:init": "rw-scripts dev-init",
    "preview": "pnpm run build && wrangler dev",
    "worker:run": "rw-scripts worker-run",
    "clean": "npm run clean:vite",
    "clean:vite": "rm -rf ./node_modules/.vite",
    "release": "rw-scripts ensure-deploy-env && npm run clean && npm run build && wrangler deploy",
    "generate": "rw-scripts ensure-env && wrangler types --include-runtime false",
    "check": "npm run generate && npm run types",
    "types": "tsc",
    "deploy": "pnpm run release",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@cf-bench/bench-config": "workspace:*",
    "@cf-bench/bench-contract": "workspace:*",
    "@cf-bench/bench-types": "workspace:*",
    "@cf-bench/chart-core": "workspace:*",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-server-dom-webpack": "19.2.5",
    "rwsdk": "1.2.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.35.0",
    "@rolldown/plugin-babel": "0.2.3",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "0.28.0",
    "typescript": "6.0.3",
    "vite": "8.0.10",
    "wrangler": "4.87.0"
  }
}
