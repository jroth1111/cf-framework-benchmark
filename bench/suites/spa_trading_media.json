{
  "id": "spa_trading_media",
  "description": "Workers-only SPA benchmark focused on chart and media interactions",
  "scenarios": [
    {
      "name": "chart",
      "routeId": "/chart",
      "type": "spa",
      "waitFor": { "requiredTestId": "chart-canvas" },
      "interactions": [
        {
          "kind": "chart-switch",
          "symbolSelect": { "requiredTestId": "symbol-select" },
          "timeframeSelect": { "requiredTestId": "timeframe-select" },
          "targetSymbol": "ETH",
          "targetTimeframe": "15m"
        }
      ]
    },
    {
      "name": "media",
      "routeId": "/media",
      "type": "spa",
      "waitFor": { "requiredTestId": "media-card" },
      "interactions": [
        {
          "kind": "media-open-first",
          "click": { "requiredTestId": "media-card" },
          "waitFor": { "requiredTestId": "media-player" }
        },
        {
          "kind": "media-next",
          "click": { "requiredTestId": "media-next" },
          "waitFor": { "requiredTestId": "media-player" }
        }
      ]
    }
  ]
}
