{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cf-bench-redwood",
	"main": "src/worker.tsx",
	"compatibility_date": "2026-03-05",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/client",
		"html_handling": "drop-trailing-slash"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"NODE_ENV": "production"
	}
}
